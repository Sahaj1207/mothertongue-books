# Copy to .env and fill in. Never commit .env.

# true = canned agent output, no API calls or credits used.
USE_MOCK_AI=true

# Meta Model API key (dev.meta.ai → API keys). Standard-mode models only.
MODEL_API_KEY=

# Supabase project URL and secret (service) key. Backend only.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Cloudflare Workers AI (free plan) for FLUX.1 [schnell] illustrations.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Baseten key for Muse Spark Open (safety reviewer).
BASETEN_API_KEY=
